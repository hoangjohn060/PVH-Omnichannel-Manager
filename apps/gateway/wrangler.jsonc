{
  "name": "pvh-omnichannel-gateway",
  "main": "src/index.ts",
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2026-10-18",
  "d1_databases": [{ "binding": "DB", "database_name": "pvh-omnichannel", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": false }
}
